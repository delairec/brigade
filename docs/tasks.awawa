TASK B01
	TITLE "Repository skeleton and entry point"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "cli"
	ROLE bastien
	SPEC "brigade --version prints the version"
	SPEC "python -m unittest passes"
	SPEC "the README names the install, a symlink into a directory on PATH"

TASK B02
	TITLE "brigade doctor"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "cli"
	ROLE bastien
	SPEC "checks awawa 2.7 or later, awawa-web, claude, the two gh accounts (the user and the"
		+ "machine account), the instructions corpus linting green, Python 3.13 or later, user"
		+ "systemd, config and state directories, schema version"
	SPEC "exits 0, or 1 with findings"
	AFTER @TASK.B01

TASK B03
	TITLE "Operational corpus schema and brigade init"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "corpus"
	ROLE bastien
	SPEC "brigade init creates the config corpus as a git repository with the schema template"
		+ "installed"
	SPEC "awawa lint --strict exits 0 on it"
	SPEC "a second init changes nothing"
	AFTER @TASK.B01

TASK B04
	TITLE "Registry commands"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "registry"
	ROLE bastien
	SPEC "project add discovers remote, main branch and corpus root and drafts ACCEPTANCE and SETUP"
		+ "lines"
	SPEC "list, show, pause, resume"
	SPEC "every write goes through fmt, lint and a commit"
	AFTER @TASK.B03

TASK B05
	TITLE "Ledger writer and reader"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "ledger"
	ROLE bastien
	SPEC "append-only monthly JSONL"
	SPEC "brigade ledger prints text and --json"
	SPEC "p50 and p90 steps per procedure are computed from the events"
	AFTER @TASK.B01

TASK B06
	TITLE "brigade run: launch a role run and capture its result"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "runs"
	ROLE bastien
	SPEC "runs a procedure as a role with claude -p --output-format stream-json, detached under"
		+ "systemd-run or in the foreground"
	SPEC "writes the result object (steps, duration, usage, session id, error class) to the ledger"
	SPEC "passes the role package with --append-system-prompt-file"
	SPEC "claude --bg evaluated and the choice recorded as a DECISION"
	AFTER @TASK.B05

TASK B07
	TITLE "Tick skeleton and systemd units"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "tick"
	ROLE bastien
	SPEC "brigade tick --once takes a lock, reconciles nothing yet and records a ledger event"
	SPEC "install-units installs the timer and the service"
	SPEC "the journal shows one tick every five minutes"
	AFTER @TASK.B05

TASK B08
	TITLE "Corpus-at-ref reader"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "corpus"
	ROLE bastien
	SPEC "brigade corpus <project> --ref <branch|sha|worktree:name> -- <awawa args> runs awawa on a"
		+ "git archive cached per SHA, or in place for a worktree"
	SPEC "the cache is pruned by size"
	AFTER @TASK.B04

TASK B09
	TITLE "Roles ada, rita and mina in the instructions corpus"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "roles"
	ROLE lex
	SPEC "three AGENT entities with WORK, REASONING and RETURNS, and their adapter files"
	SPEC "awawa lint --strict green on the corpus"
	SPEC "delivered as a pull request on the instructions repository"

TASK B10
	TITLE "Procedure wave-plan.md and brigade plan context|record"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "planning"
	ROLE bastien
	SPEC "plan context prints the planning package"
	SPEC "plan record --file validates the plan JSON against the TASK and WAVE schema, writes the"
		+ "entities, runs fmt and lint, creates the integration branch and commits"
	SPEC "a lint failure comes back as one correction request"
	AFTER @TASK.B04
	AFTER @TASK.B09

TASK B11
	TITLE "brigade wave new|show|list"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "waves"
	ROLE bastien
	SPEC "a request becomes a REQUEST entity and a planned wave"
	SPEC "show prints the task table with states from the ledger"
	SPEC "POLICY.PLAN_REVIEW ask|auto is honoured"
	AFTER @TASK.B10

TASK B12
	TITLE "Scheduler: startable tasks, slots, worktrees, briefs, launches"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "tick"
	ROLE bastien
	SPEC "startable means every AFTER merged and no live BLOCKED_BY"
	SPEC "the overlap order comes from the plan"
	SPEC "a worktree is cut from the integration head with the SETUP commands run and ancestry"
		+ "asserted"
	SPEC "the brief is filled from a template"
	SPEC "bastien is launched through brigade run within the slot cap"
	AFTER @TASK.B06
	AFTER @TASK.B07
	AFTER @TASK.B11

TASK B13
	TITLE "brigade task context|check|pr|promote"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "agent side"
	ROLE bastien
	SPEC "context prints the whole starting package in one command"
	SPEC "check runs the ACCEPTANCE commands plus fmt --check and lint --strict with a bounded"
		+ "summary"
	SPEC "pr pushes and opens the pull request with a templated body"
	SPEC "promote sets STATUS implemented and DELIVERED_BY, runs fmt and lint, commits and pushes"
	AFTER @TASK.B12

