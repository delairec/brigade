TASK B01
	TITLE "Repository skeleton and entry point"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "cli"
	ROLE bastien
	SPEC "brigade --version prints the version, as JSON with --json, proven by a black-box test run"
		+ "by subprocess"
	SPEC "python -m unittest passes"
	SPEC "the README names the install, a symlink into a directory on PATH"

TASK B02
	TITLE "brigade doctor"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "cli"
	ROLE bastien
	SPEC "checks awawa 2.7 or later, awawa-web, the agent CLI of each adapter, the gh account and"
		+ "the machine account when SETTINGS names one, the instructions corpus linting green when"
		+ "SETTINGS names one, Python 3.13 or later, user systemd, config and state directories,"
		+ "schema version"
	SPEC "exits 0, or 1 with findings"
	AFTER @TASK.B01

TASK B03
	TITLE "Operational corpus schema and brigade init"
	STATUS draft
	MILESTONE @MILESTONE.M0
	COMPONENT "corpus"
	ROLE bastien
	SPEC "brigade init creates the config corpus as a git repository with the schema template"
		+ "installed"
	SPEC "awawa lint --strict exits 0 on it"
	SPEC "init asks whether to import the roles the user defines or to use brigade's default roles,"
		+ "and writes the SETTINGS entity with the answer"
	SPEC "a second init changes nothing"
	AFTER @TASK.B01

TASK B04
	TITLE "Registry commands"
