TASK B19
	TITLE "Quota pause and resume"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "runs"
	ROLE bastien
	SPEC "a rate-limit result pauses the wave with resume_at set from the result's resets_at, else"
		+ "to now plus 30 minutes"
	SPEC "the first tick after resume_at resumes each suspended run through resume(session_ref), or"
		+ "relaunches it with its brief and its progress file when the adapter does not resume by"
		+ "ref"
	SPEC "ledger events wave.paused and wave.resumed"
	AFTER @TASK.B14

