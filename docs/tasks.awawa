	TITLE "brigade verify preflight"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "the pass"
	ROLE bastien
	SPEC "the eight deterministic checks (ancestry, checks, corpus, promotion, untouched files,"
		+ "privacy, body, size) with a findings JSON and exit 1 on failure"
	AFTER @TASK.B08
	AFTER @TASK.B14

TASK B16
	TITLE "Procedure verify-pr.md and brigade verify context|verdict"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "the pass"
	ROLE bastien
	ROLE lex
	SPEC "prudence receives the verification package and posts approve or request changes through"
		+ "verdict, as the machine account, with the ledger event"
	AFTER @TASK.B15

TASK B17
	TITLE "Auto-merge into integration and scheduling of dependents"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "tick"
	ROLE bastien
	SPEC "approve plus green checks merge the pull request with PROJECT.MERGE"
	SPEC "the task becomes merged"
	SPEC "its dependents become startable in the same tick"
	AFTER @TASK.B16

TASK B18
	TITLE "Repair paths"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "tick"
	ROLE bastien
	SPEC "changes requested starts a remi round through review context|reply"
	SPEC "a failing check starts a bastien fix"
	SPEC "a branch behind integration is rebased by git and manu runs only on a conflict through"
		+ "rebase context|done"
	SPEC "rounds are capped by POLICY.VERIFY_ROUNDS, then the task is parked with the reason"
	AFTER @TASK.B17

TASK B19
	TITLE "Quota pause and resume"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "runs"
	ROLE bastien
	SPEC "a rate-limit result pauses the wave with resume_at parsed from the message or set to now"
		+ "plus 30 minutes"
	SPEC "the first tick after resume_at resumes each suspended run with --resume"
	SPEC "ledger events wave.paused and wave.resumed"
	AFTER @TASK.B14

