	TITLE "Pull-request tracking in the tick"
	STATUS draft
	MILESTONE @MILESTONE.M1
	COMPONENT "tick"
	ROLE bastien
	SPEC "the tick finds the pull request of a task branch, reads its checks and review state"
		+ "through gh, records ledger events and moves the task state"
	AFTER @TASK.B12

