#!/bin/sh
if [ -n "$BRIGADE_GH_RECORD" ]; then printf '%s\n' "$*" >> "$BRIGADE_GH_RECORD"; fi
case "$*" in
  "auth token --hostname github.com --user refused-bot")
    echo "no oauth token found for github.com account refused-bot" >&2
    exit 1 ;;
  "auth token --hostname github.com --user "*)
    printf 'token-of-%s\n' "$6" ;;
  "auth status --active --hostname github.com --json hosts")
    login="${GH_TOKEN#token-of-}"
    printf '{"hosts":{"github.com":[{"state":"success","active":true,"host":"github.com","login":"%s"}]}}\n' "${login:-octo-user}" ;;
  *) exit 2 ;;
esac
