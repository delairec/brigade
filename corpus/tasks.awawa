		IMPL "tests/unit/adapters/clients/test_claude_code.py::class"
			+ "ClaudeCodeResultTest(unittest.TestCase)"
	SPEC "the reasoning-to-model table of the Claude Code adapter ships with defaults, deepest"
		+ "fable and max, deep fable and high, standard opus and high, light sonnet and medium; a"
		+ "level set in config.toml replaces its row"
		IMPL "brigade/adapters/clients/claude_code.py::REASONING_DEFAULTS = {"
		IMPL "tests/unit/adapters/clients/test_claude_code.py::def"
			+ "test_should_map_each_reasoning_level_to_its_default_model_and_effort"
		IMPL "tests/cli/test_adapter.py::def test_should_take_the_reasoning_row_config_toml_sets"
	SPEC "the Claude Code adapter resumes a session by its id and answers transcripts with the"
		+ "messages of a session read from its JSONL file under the Claude Code projects directory;"
		+ "its probe declares every operation present"
