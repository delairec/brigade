		IMPL "tests/unit/commands/test_init.py::def"
			+ "test_should_write_a_configuration_read_as_an_empty_table(self):"
	SPEC "brigade/system/paths builds the config, state and cache roots from XDG_CONFIG_HOME,"
		+ "XDG_STATE_HOME and XDG_CACHE_HOME with their defaults; the tests redirect brigade with"
		+ "these variables alone"
