TASK B115
	TITLE "brigade needs Python 3.11.4 or later and always extracts a project archive under"
		+ "tarfile's data filter"
	STATUS implemented
	MILESTONE @MILESTONE.F0
	COMPONENT "corpus"
	ROLE ada
