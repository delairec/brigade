		IMPL "tests/unit/adapters/clients/test_claude_code.py::class"
			+ "ClaudeCodeResultTest(unittest.TestCase)"
	SPEC "the reasoning-to-model table of the Claude Code adapter ships with defaults, deepest"
		+ "fable and max, deep fable and high, standard opus and high, light sonnet and medium; a"
		+ "level set in config.toml replaces its row"
		IMPL "brigade/adapters/clients/claude_code.py::REASONING_DEFAULTS = {"
