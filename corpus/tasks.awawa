		IMPL "brigade/commands/doctor.py::path=(\"doctor\",),"
		IMPL "brigade/commands/doctor.py::def _render_text(document: dict) -> str:"
		IMPL "tests/cli/test_doctor.py::def test_should_print_the_report_as_text"
		IMPL "tests/cli/test_doctor.py::class BrigadeDoctorAsTextWithAFindingAndAWarningTest"
	SPEC "it exits 0, or 1 with findings; a missing optional item is a warning, never a finding"
		IMPL "brigade/commands/doctor.py::def _decide_exit_code(document: dict) -> int:"
