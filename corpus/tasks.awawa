	SPEC "brigade collectors list prints every collector found, its name and its source, project,"
		+ "machine, PATH or built-in, text and --json carrying schema_version"
		IMPL "brigade/system/list_collectors.py::def list_collectors(places: CollectorPlaces) ->"
			+ "list[dict]:"
		IMPL "tests/cli/test_collect.py::class BrigadeCollectorsListTest(CollectTestCase):"
	SPEC "the built-in git-log: items are the commits reachable from HEAD since BRIGADE_SINCE, each"
		+ "with sha, author name, date, subject and the files changed, none for a merge commit,"
		+ "whose files are counted on the commits of the branch it merges; summary counts the"
