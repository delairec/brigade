			+ "ReadUpstreamLagWithNothingBehindTest"
	SPEC "a git read of the checkout that fails (git absent or failing, an upstream configured but"
		+ "no longer fetched) reports the checkout item in the warning state, the detail naming the"
		+ "checkout and the error, never a finding"
		IMPL "brigade/commands/doctor.py::f\"{checkout}: {error}\""
		IMPL "tests/cli/test_doctor.py::def"
			+ "test_should_warn_that_the_checkout_is_unreadable_when_its_upstream_is_no_longer_fetched(self):"
		IMPL "tests/cli/test_doctor.py::class BrigadeDoctorWithoutGitTest"
	SPEC "git is read through the runner and the git gateway, as every subprocess is;"
