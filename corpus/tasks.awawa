			+ "ClaudeCodeTranscriptsTest(unittest.TestCase)"
		IMPL "tests/unit/adapters/clients/test_claude_code.py::def"
			+ "test_should_declare_every_operation_present"
	SPEC "an adapter is a built-in module or an executable brigade-client-<name> on PATH; the"
		+ "client key of config.toml selects it"
		IMPL "brigade/system/resolve_plugin.py::def _resolve_client(name: str, runtime):"
		IMPL "tests/cli/test_adapter.py::def"
			+ "test_should_answer_through_an_executable_adapter_on_path"
