			+ "test_should_record_the_budget_exceeded_and_the_step_cap_reached_naming_the_procedure_and_the_run(self):"
		IMPL "tests/cli/test_run.py::def"
			+ "test_should_record_no_budget_signal_for_steps_it_does_not_count(self):"
	SPEC "signal.recorded gains the optional field steps, written on budget_exceeded alone and"
		+ "absent from every other signal, as DESC 1 of the decision declaring the ledger events"
		+ "states"
		IMPL "brigade/ledger/signal_recorded.py::steps: int | None = None"
		IMPL "tests/unit/ledger/test_signal_recorded.py::def"
			+ "test_should_write_back_the_steps_of_a_segment_over_its_budget(self):"
	SPEC "tests/cli runs brigade run as a subprocess with the fake client declaring step_count and"
		+ "reporting one step more than the budget and no error: the run ends done, exit 0, and the"
		+ "ledger holds the budget_exceeded signal with its steps and budget; at exactly the"
