			+ "test_should_list_the_commits_since_the_day_with_the_files_they_touch(self):"
		IMPL "tests/unit/collectors/test_git_log.py::def"
			+ "test_should_list_the_commits_since_the_start_with_the_files_they_touched(self):"
	SPEC "the built-in git-diff-stat: items are the files changed between the refs the parameters"
		+ "from and to name, PROJECT.MAIN and HEAD by default, each with its insertions and"
		+ "deletions; summary totals them"
		IMPL "brigade/git/count_changed_lines.py::def count_changed_lines("
		IMPL "tests/unit/collectors/test_git_diff_stat.py::def"
			+ "test_should_count_from_the_main_branch_of_the_project_to_head_by_default(self):"
	SPEC "the built-in worktrees: items are the worktrees of the project's repository through the"
		+ "gateway of brigade/git/, each with path, branch, head and whether it is detached or"
		+ "locked; summary counts them"
		IMPL "brigade/git/list_worktrees.py::detached=DETACHED_LINE in lines,"
		IMPL "tests/unit/collectors/test_worktrees.py::def"
			+ "test_should_list_the_worktrees_of_the_project(self):"
	SPEC "the built-in corpus: items are the entities of awawa status --json of the project's"
		+ "corpus at the ref the parameter ref names, HEAD by default, read through the tree cache"
		+ "of brigade corpus; summary is the counts by type and STATUS"
		IMPL "brigade/collectors/corpus.py::status = json.loads(run_awawa(runtime.run_process,"
			+ "tree.root, STATUS_ARGUMENTS).stdout)"
		IMPL "tests/unit/collectors/test_corpus.py::def"
			+ "test_should_count_the_entities_of_the_corpus_at_head_by_type(self):"
	SPEC "the built-in ledger: items are the events of the ledger since BRIGADE_SINCE, narrowed to"
		+ "the project of BRIGADE_PROJECT_PATH when it is registered; summary aggregates them by"
		+ "event name and, for run.finished, by outcome"
		IMPL "brigade/collectors/ledger.py::return lambda event: project is None or"
			+ "_read_project(event) == project.name"
		IMPL "tests/unit/collectors/test_ledger.py::def"
			+ "test_should_count_the_events_of_the_project_since_the_start(self):"
	SPEC "no built-in launches a model: the test suite runs every built-in with no client on PATH"
