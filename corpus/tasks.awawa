	SPEC "awawa lint --strict exits 0 on the created corpus"
		IMPL "tests/cli/test_init.py::def test_should_create_a_corpus_that_lints_clean"
	SPEC "the schema template lives at brigade/corpus/data/schema.awawa.tpl and schema/ is gone"
		+ "from the repository root; init run from the clone and from dist/brigade.pyz installs the"
		+ "same file"
		IMPL "brigade/corpus/data/schema.awawa.tpl::SCHEMA *"
		IMPL "tests/cli/test_init.py::def test_should_install_the_shipped_schema"
		IMPL "tests/cli/test_zipapp.py::def"
			+ "test_should_install_the_schema_the_clone_ships_from_the_built_archive"
	SPEC "init writes config.toml once from a shipped string.Template, every key commented out with"
		+ "its meaning; tomllib reads it as an empty table"
		IMPL "brigade/corpus/data/config.toml.tpl::# The client adapter that runs the agents"
		IMPL "tests/cli/test_init.py::def test_should_write_a_configuration_read_as_an_empty_table"
	SPEC "brigade/system/paths builds the config, state and cache roots from XDG_CONFIG_HOME,"
		+ "XDG_STATE_HOME and XDG_CACHE_HOME with their defaults; the tests redirect brigade with"
		+ "these variables alone"
		IMPL "brigade/system/paths.py::def build_paths() -> Paths:"
		IMPL "tests/unit/system/test_paths.py::class BuildPathsTest(unittest.TestCase)"
		IMPL "tests/cli/temporary_machine.py::def describe_environment(self) -> dict:"
	SPEC "init creates no $XDG_CACHE_HOME/brigade/ and writes nothing in $XDG_STATE_HOME/brigade/"
		+ "but the trail of its command"
		IMPL "tests/cli/test_init.py::def"
			+ "test_should_write_its_command_trail_alone_in_the_state_root_and_create_no_cache_root"
	SPEC "a second init rewrites nothing and commits nothing; a present file that differs from the"
		+ "shipped one is left as it is and reported as a warning, exit 0"
		IMPL "tests/cli/test_init.py::class BrigadeInitRunTwiceTest(unittest.TestCase)"
		IMPL "tests/cli/test_init.py::class"
			+ "BrigadeInitWhenAFileDiffersFromTheShippedOneTest(unittest.TestCase)"
	SPEC "without a git user.name or user.email, init exits 1 with a message naming the missing"
		+ "key, before creating anything"
		IMPL "brigade/commands/init.py::def _require_identity(runtime: Runtime) -> None:"
		IMPL "tests/cli/test_init.py::class BrigadeInitWithoutAGitIdentityTest(unittest.TestCase)"
	SPEC "it prints text and --json; the JSON document carries schema_version and one entry per"
		+ "item, the repository, the schema, the .gitignore and config.toml, each with its state:"
		+ "created, present or differs"
		IMPL "brigade/commands/init.py::def _render_text(document: dict) -> str:"
		IMPL "tests/cli/test_init.py::def"
			+ "test_should_report_every_item_created_in_the_versioned_document"
		IMPL "tests/cli/test_init.py::def test_should_print_the_report_as_text"
	AFTER @TASK.B01
	AFTER @TASK.B02
	RATIONALE "the registry, the policies, the studies, the orders and the requests are written"
		+ "into this corpus; @TASK.B04 and @TASK.B43 wait on it"
		REF @TASK.B04
		REF @TASK.B43
	RATIONALE "the template moves under the package because"
		+ "@DECISION.ShippedFilesLiveInsideThePackageAndAreReadAsResources rejects a root-level"
		+ "schema/, absent from dist/brigade.pyz; the place of the corpus, its .gitignore and"
		+ "config.toml written once at init follow"
		+ "@DECISION.PathsAndConfigurationAreResolvedInOnePlaceFromXdgVariables, which also leaves"
		+ "the state and cache directories to their writers"
		REF @DECISION.ShippedFilesLiveInsideThePackageAndAreReadAsResources
		REF @DECISION.PathsAndConfigurationAreResolvedInOnePlaceFromXdgVariables
	RATIONALE "config.toml is written, not read: the frozen record and its validation arrive with"
