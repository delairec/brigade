			+ "test_should_record_the_study_with_the_question_verbatim(self):"
		IMPL "tests/unit/studies/test_record_study.py::def"
			+ "test_should_write_a_study_of_a_project_asking_a_question_on_a_schedule(self):"
		IMPL "tests/unit/commands/test_study_new.py::def"
			+ "test_should_run_a_study_with_no_schedule_at_once(self):"
	SPEC "study run runs the ordered steps collect, judge and output: the collectors, then the"
		+ "slot's role through brigade run with the procedure study.md, then the output; a study"
		+ "with SLOT none writes the answer entity holding the fields the CLI filled to its output"
		+ "and launches nothing"
		IMPL "brigade/studies/run_study.py::def run_study(runtime: Runtime, study: Study,"
			+ "equipment: StudyEquipment, started_run: str | None) -> dict:"
		IMPL "brigade/studies/judge_evidence.py::def judge_evidence(context: StudyRunContext) ->"
			+ "dict:"
