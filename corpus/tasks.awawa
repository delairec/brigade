		IMPL "brigade/git/commit_files.py::def commit_files("
		IMPL "tests/integration/git/test_commit_files.py::def"
			+ "test_should_commit_the_files_named_alone_under_the_git_identity_with_the_message(self):"
		IMPL "tests/unit/commands/test_init.py::def"
			+ "test_should_commit_them_under_the_message_of_the_operational_corpus(self):"
		IMPL "tests/unit/commands/test_init.py::def"
			+ "test_should_keep_the_configuration_out_of_the_repository(self):"
	SPEC "awawa lint --strict exits 0 on the created corpus"
		IMPL "tests/integration/corpus/test_check_corpus.py::def"
			+ "test_should_find_a_corpus_holding_the_shipped_schema_alone_clean(self):"
	SPEC "the schema template lives at brigade/corpus/data/schema.awawa.tpl and schema/ is gone"
		+ "from the repository root; init run from the clone and from dist/brigade.pyz installs the"
		+ "same file"
		IMPL "brigade/corpus/data/schema.awawa.tpl::SCHEMA *"
		IMPL "tests/unit/commands/test_init.py::def test_should_install_the_shipped_schema(self):"
		IMPL "tests/cli/test_zipapp.py::def"
			+ "test_should_install_the_schema_the_clone_ships_from_the_built_archive"
	SPEC "init writes config.toml once from a shipped string.Template, every key commented out with"
		+ "its meaning; tomllib reads it as an empty table"
