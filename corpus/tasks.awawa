		IMPL "tests/integration/corpus/test_prepare_tree.py::class"
			+ "PrepareTreeAtABranchOrASha(PrepareTreeTestCase):"
	SPEC "--ref worktree:<branch> names the project's worktree where that branch is checked out;"
		+ "--worktree <path> names one by its path, a detached HEAD included; either is read in"
		+ "place, uncommitted edits visible, with kind worktree and sha its HEAD; --ref and"
		+ "--worktree together exit 2"
		IMPL "brigade/corpus/prepare_tree.py::def _find_worktree("
		IMPL "brigade/git/list_worktrees.py::def list_worktrees("
		IMPL "brigade/cli.py::trees = corpus_parser.add_mutually_exclusive_group(required=True)"
