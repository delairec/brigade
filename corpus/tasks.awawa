			+ "test_should_record_each_step_and_the_order_done(self):"
		IMPL "tests/unit/ledger/test_append_event.py::class"
			+ "AppendEventOfAStudyRunTest(AppendEventTestCase):"
		IMPL "tests/unit/studies/test_run_study.py::def"
			+ "test_should_record_the_failed_step_and_the_order_parked(self):"
		IMPL "tests/unit/studies/test_run_study.py::def"
			+ "test_should_resume_the_parked_run_of_the_study(self):"
