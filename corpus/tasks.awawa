			+ "test_should_run_the_collector_again_after_a_failure(self):"
		IMPL "tests/unit/collecting/test_read_cache_input.py::def"
			+ "test_should_key_a_repository_collector_on_the_commit_of_head(self):"
		IMPL "tests/unit/collecting/test_collect_document.py::def"
			+ "test_should_collect_again_once_its_cache_input_changed(self):"
		IMPL "brigade/collecting/collect_document.py::if not"
			+ "files[DOCUMENT_FILE].get(CACHE_DECLARATION, NOT_CACHED):"
		IMPL "brigade/collecting/describe_collection.py::CACHED_DOCUMENT = True"
		IMPL "tests/unit/collecting/test_collect_document.py::def"
			+ "test_should_run_a_collector_declaring_no_cache_again_at_each_call(self):"
		IMPL "tests/unit/collectors/test_git_log.py::def"
			+ "test_should_list_the_commits_since_the_start_with_the_files_they_touched(self):"
	SPEC "--refresh ignores the cache and replaces the entry of a collector that declares cache"
		+ "true"
		IMPL "brigade/collecting/collect_document.py::cached = not request.refresh and"
		IMPL "tests/unit/collecting/test_collect_document.py::def"
			+ "test_should_collect_again_when_a_refresh_is_asked(self):"
	SPEC "collectors resolve in order: <project>/.brigade/collectors/<name>,"
		+ "$XDG_CONFIG_HOME/brigade/collectors/<name>, brigade-collector-<name> on PATH, the"
		+ "built-ins of brigade/collectors/; the first found answers, and an unknown name exits 1"
