RECIPE acceptance
	SCHEMA_VERSION 1
	MAX_WALL 30
	STEP command
		ARGV "python3"
		ARGV "-m"
		ARGV "unittest"
	STEP command
		ARGV "awawa"
		ARGV "fmt"
		ARGV "--check"
		ARGV "."
	STEP command
		ARGV "awawa"
		ARGV "lint"
		ARGV "--strict"
		ARGV "."
	STEP command
		ARGV "uvx"
		ARGV "--from"
		ARGV "ruff==0.17.2"
		ARGV "ruff"
		ARGV "check"
		ARGV "."
	STEP command
		ARGV "uvx"
		ARGV "--from"
		ARGV "ruff==0.17.2"
		ARGV "ruff"
		ARGV "format"
		ARGV "--check"
		ARGV "."
	STEP command
		ARGV "uvx"
		ARGV "--from"
		ARGV "coverage==7.17.0"
		ARGV "coverage"
		ARGV "run"
		ARGV "-m"
		ARGV "unittest"
		ARGV "discover"
		ARGV "-s"
		ARGV "tests/unit"
		ARGV "-t"
		ARGV "."
	STEP command
		ARGV "uvx"
		ARGV "--from"
		ARGV "coverage==7.17.0"
		ARGV "coverage"
		ARGV "report"
