	RATIONALE "the SPEC of @TASK.B31 names the order outputs among the reports, after"
		+ "@DECISION.EveryDocumentBrigadeReadsBackAcceptsAnAwawaFormAndTextIsARenderingHandedWhole;"
		+ "no code writes one, so no test can list one before @TASK.B51"
		REF @TASK.B31
		REF @DECISION.EveryDocumentBrigadeReadsBackAcceptsAnAwawaFormAndTextIsARenderingHandedWhole
		REF @TASK.B51
	SOURCE "pull request #242 of the brigade repository, delivering @TASK.B31"
		REF @TASK.B31

DECISION TheCorpusViewReadsBrigadeCorpusAndItsBoardReadsEachEntity
	TITLE "the Corpus view reads brigade corpus --type, --field and --entity through"
